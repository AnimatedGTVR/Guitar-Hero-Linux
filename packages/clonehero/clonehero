#!/bin/sh
set -u

VERSION=1.1.0.6142
URL=https://github.com/clonehero-game/releases/releases/download/v1.1.0.6142-final/Linux.x86_64-Standalone.tar
SHA1=63350926e834b72a7ca193d46391199076f91bf3
GAME_DIR=${CLONEHERO_HOME:-/opt/clonehero}
ARCHIVE=${CLONEHERO_ARCHIVE:-/var/cache/clonehero/clonehero-$VERSION.tar}
EULA=https://clonehero.net/eula/

game_binary() {
    for candidate in \
        "$GAME_DIR/clonehero" \
        "$GAME_DIR/Clone Hero/clonehero" \
        "$GAME_DIR/CloneHero/clonehero"
    do
        [ -f "$candidate" ] && { printf '%s\n' "$candidate"; return 0; }
    done
    find "$GAME_DIR" -maxdepth 3 -type f -name clonehero 2>/dev/null | head -n 1
}

doctor() {
    failed=0
    printf '\033[1;36mClone Hero platform check\033[0m\n\n'
    check() {
        if sh -c "$2"; then
            printf '\033[1;32m[ok]\033[0m   %s\n' "$1"
        else
            printf '\033[1;33m[wait]\033[0m %s\n' "$1"
            failed=1
        fi
    }
    check 'DRM graphics device' 'ls /dev/dri/card* >/dev/null 2>&1'
    check 'ALSA audio device' 'test -d /dev/snd'
    check 'graphical session (DISPLAY or WAYLAND_DISPLAY)' 'test -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}"'
    if [ -n "$(game_binary)" ]; then
        printf '\033[1;32m[ok]\033[0m   Clone Hero game payload\n'
    else
        printf '\033[1;33m[wait]\033[0m Clone Hero game payload\n'
        failed=1
    fi
    printf '\nControllers visible through evdev:\n'
    found=0
    for event in /dev/input/event*; do
        [ -e "$event" ] || continue
        printf '  %s\n' "$event"
        found=1
    done
    [ "$found" -eq 1 ] || printf '  none yet\n'
    return "$failed"
}

status() {
    binary=$(game_binary)
    if [ -n "$binary" ]; then
        printf 'installed\nversion: %s\nexecutable: %s\nsongs: %s\n' \
            "$VERSION" "$binary" "/root/Clone Hero/Songs"
        return 0
    fi
    if [ -s "$ARCHIVE" ]; then
        bytes=$(wc -c < "$ARCHIVE")
        printf 'not installed\npartial download: %s bytes\nresume with: clonehero install\n' "$bytes"
    else
        printf 'not installed\nrun: clonehero install\n'
    fi
    return 1
}

install_game() {
    accept=${1:-}
    printf '\033[1;36mClone Hero %s installer\033[0m\n\n' "$VERSION"
    printf 'Official download: %s\n' "$URL"
    printf 'Download size: approximately 1.17 GB\nInstall path: %s\n\n' "$GAME_DIR"
    if [ "$accept" != "--accept-eula" ]; then
        printf 'Installing means accepting the Clone Hero EULA:\n%s\n\n' "$EULA"
        printf 'Type ACCEPT to download and install: '
        IFS= read -r answer
        [ "$answer" = ACCEPT ] || { echo 'Cancelled.'; return 1; }
    fi
    mkdir -p "$GAME_DIR" "$(dirname "$ARCHIVE")"
    available_kb=$(df -Pk "$(dirname "$ARCHIVE")" | awk 'NR == 2 { print $4 }')
    required_kb=${CLONEHERO_REQUIRED_KB:-3000000}
    if [ -z "$available_kb" ] || [ "$available_kb" -lt "$required_kb" ]; then
        printf 'Clone Hero needs at least 3 GB free on the install disk.\n' >&2
        printf 'Available: %s KB at %s\n' "${available_kb:-unknown}" "$(dirname "$ARCHIVE")" >&2
        return 1
    fi
    printf '\nDownloading official Linux build (safe to resume)...\n'
    if [ -s "$ARCHIVE" ]; then
        printf 'Resuming cached download: %s\n' "$ARCHIVE"
        curl -fL --retry 4 --retry-delay 2 -C - --progress-bar -o "$ARCHIVE" "$URL" || return 1
    else
        curl -fL --retry 4 --retry-delay 2 --progress-bar -o "$ARCHIVE" "$URL" || return 1
    fi
    actual=$(sha1sum "$ARCHIVE" | awk '{print $1}')
    if [ "$actual" != "$SHA1" ]; then
        printf 'Checksum mismatch. Expected %s, got %s\n' "$SHA1" "$actual" >&2
        return 1
    fi
    printf 'Checksum verified. Extracting...\n'
    tar -xf "$ARCHIVE" -C "$GAME_DIR" || return 1
    binary=$(game_binary)
    if [ -z "$binary" ]; then
        echo 'Archive extracted, but no Clone Hero executable was found.' >&2
        return 1
    fi
    chmod +x "$binary"
    mkdir -p /root/'Clone Hero'/Songs /root/.clonehero
    rm -f "$ARCHIVE"
    printf '\033[1;32mClone Hero %s installed.\033[0m\n' "$VERSION"
}

remove_game() {
    binary=$(game_binary)
    if [ -z "$binary" ]; then
        echo 'Clone Hero is not installed.'
        return 0
    fi
    printf 'Remove the game from %s? Songs and player data will be kept. [y/N] ' "$GAME_DIR"
    IFS= read -r answer
    case "$answer" in y|Y|yes|YES) rm -rf "$GAME_DIR"; echo 'Clone Hero removed.' ;; *) echo 'Cancelled.'; return 1 ;; esac
}

clean_cache() {
    if [ -e "$ARCHIVE" ]; then
        rm -f "$ARCHIVE"
        echo 'Clone Hero download cache cleared.'
    else
        echo 'Clone Hero download cache is already empty.'
    fi
}

case "${1:-run}" in
    doctor) doctor ;;
    status) status ;;
    install) shift; install_game "${1:-}" ;;
    remove|uninstall) remove_game ;;
    clean) clean_cache ;;
    --version) echo "Clone Hero launcher $VERSION" ;;
    run)
        shift
        doctor || { echo; echo "Run 'clonehero install' for the game payload."; exit 1; }
        binary=$(game_binary)
        cd "$(dirname "$binary")" || exit 1
        mkdir -p /var/log
        # Unity otherwise reuses a stale saved resolution and writes its most
        # useful failure details into a per-user directory.  Give the game a
        # deterministic fullscreen surface and one predictable diagnostic log.
        exec "$binary" \
            -screen-fullscreen 1 \
            -screen-width "${CLONEHERO_WIDTH:-1280}" \
            -screen-height "${CLONEHERO_HEIGHT:-720}" \
            -logFile "${CLONEHERO_LOG:-/var/log/clonehero-player.log}" \
            "$@"
        ;;
    *) echo 'usage: clonehero [run|status|doctor|install [--accept-eula]|remove|clean|--version]' >&2; exit 2 ;;
esac
