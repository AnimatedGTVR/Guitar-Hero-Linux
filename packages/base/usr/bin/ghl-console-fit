#!/bin/sh

# fbcon normally updates TTY geometry itself. Standalone Xorg can change the
# DRM mode while it owns the display, though, leaving applications with the
# old row/column count when it hands tty1 back. Re-read the framebuffer and
# make that handoff deterministic for the built-in 8x16 console font.
[ -t 0 ] || exit 0
[ -r /sys/class/graphics/fb0/virtual_size ] || exit 0

size=$(cat /sys/class/graphics/fb0/virtual_size 2>/dev/null)
case "$size" in
    *,*)
        width=${size%,*}
        height=${size#*,}
        ;;
    *) exit 0 ;;
esac
case "$width" in ''|*[!0-9]*) exit 0 ;; esac
case "$height" in ''|*[!0-9]*) exit 0 ;; esac

columns=$((width / 8))
rows=$((height / 16))
[ "$columns" -ge 40 ] || columns=40
[ "$rows" -ge 20 ] || rows=20
stty cols "$columns" rows "$rows" 2>/dev/null || true
printf '\033[0m\033[?25h'
